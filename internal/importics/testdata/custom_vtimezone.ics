BEGIN:VCALENDAR
PRODID:-//Example Calendar//Test//EN
VERSION:2.0
BEGIN:VEVENT
UID:custom-fixed-1@example.com
SUMMARY:XX100 check-in desk opens
DTSTART;TZID=Example Zone:20260701T090000
DTEND;TZID=Example Zone:20260701T110000
END:VEVENT
BEGIN:VEVENT
UID:custom-dst-1@example.com
SUMMARY:Test Traveller arrives at Test Hotel
DTSTART;TZID="Example DST Zone":20260328T120000
DTEND;TZID="Example DST Zone":20260329T120000
END:VEVENT
BEGIN:VTIMEZONE
TZID:Example Zone
BEGIN:STANDARD
DTSTART:19700101T000000
TZOFFSETFROM:+0530
TZOFFSETTO:+0530
END:STANDARD
END:VTIMEZONE
BEGIN:VTIMEZONE
TZID:Example DST Zone
BEGIN:DAYLIGHT
DTSTART:19810329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
END:DAYLIGHT
BEGIN:STANDARD
DTSTART:19961027T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
END:STANDARD
END:VTIMEZONE
END:VCALENDAR
